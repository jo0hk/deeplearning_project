# 이 파일을 .env로 복사한 뒤 키를 채운다. .env는 git에 올리지 않는다.

# 서울 열린데이터광장
SEOUL_API_KEY=your_key_here

# KOPIS 공연예술통합전산망
KOPIS_SERVICE_KEY=your_key_here

# 기상청 API허브 (apihub.kma.go.kr)
KMA_API_KEY=your_key_here

# 모델 경로
MODEL_CHECKPOINT_PATH=./checkpoints/best_model.pt

# DB
DATABASE_URL=sqlite:///./subway_forecast.db
